# Researcher sign-in (set these in the host's environment variables, never in the repository)
RESEARCHER_USER=
RESEARCHER_PASSWORD=
SESSION_SECRET=
# Database: a Postgres connection string (Neon or any Postgres). Use the pooled one if you have both.
DATABASE_URL=
# DATABASE_URL_POOLED=
# Local testing without an account: LID_LOCAL_DB=1 uses an in-memory Postgres that is empty on every start.
